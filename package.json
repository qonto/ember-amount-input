{
  "name": "ember-amount-input",
  "version": "7.3.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qonto/ember-amount-input.git"
  },
  "license": "MIT",
  "author": "",
  "scripts": {
    "build": "pnpm --filter ember-amount-input build",
    "lint": "pnpm --filter '*' lint",
    "lint:fix": "pnpm --filter '*' lint:fix",
    "lint:types": "pnpm --filter '*' lint:types",
    "postinstall": "lefthook install",
    "prepare": "pnpm build",
    "release": "release-it",
    "start": "concurrently 'pnpm:start:*' --restart-after 5000 --prefix-colors cyan,white,yellow",
    "start:addon": "pnpm --filter ember-amount-input start",
    "start:test-app": "pnpm --filter test-app start",
    "test": "pnpm --filter '*' test"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@release-it-plugins/workspaces": "^6.0.0",
    "@release-it/conventional-changelog": "^11.0.1",
    "concurrently": "^10.0.3",
    "lefthook": "^2.1.10",
    "prettier": "^3.2.5",
    "release-it": "^19.2.4"
  },
  "engines": {
    "node": ">= 20"
  },
  "volta": {
    "node": "20.18.1"
  },
  "packageManager": "pnpm@8.6.5",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "pnpm": {
    "overrides": {
      "@rollup/pluginutils": "^5.4.0"
    }
  }
}
